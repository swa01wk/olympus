# Source after: make integrations-up && make integrations-seed
#   set -a && source .env && source config/integrations/oss-dev.env && set +a
#
# OSS stack: Gitea (git + issues), MinIO (S3), in-repo CI runner + fault proxy.

OLYMPUS_GITEA_URL=http://127.0.0.1:3000
GITEA_ADMIN_USER=olympus
GITEA_ADMIN_PASSWORD=olympus-integration
GITEA_ADMIN_EMAIL=olympus@test.local

OLYMPUS_MINIO_URL=http://127.0.0.1:9000
MINIO_ROOT_USER=olympus
MINIO_ROOT_PASSWORD=olympus-minio-secret

OLYMPUS_CI_RUNNER_URL=http://127.0.0.1:8090
OLYMPUS_FAULT_PROXY_URL=http://127.0.0.1:9099

# Set via: export GITEA_API_TOKEN="$(./scripts/integrations-seed.sh)"
# GITEA_API_TOKEN=

# Prefer Gitea for remote repositories (Phase 16)
GIT_PROVIDER=gitea
