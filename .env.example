DATABASE_URL=postgresql+psycopg://olympus:olympus@localhost:5432/olympus
OLYMPUS_ENV=local
OLYMPUS_STORAGE_ROOT=./var/olympus
OLYMPUS_WORKSPACE_BACKEND=LOCAL_FILESYSTEM
OLYMPUS_WORKSPACE_ROOT=./var/olympus/workspaces
OLYMPUS_WORKTREE_ROOT=
OLYMPUS_SECRET_KEY=
MODEL_PROVIDER=openai
MODEL_DEFAULT=gpt-5.4-mini
MODEL_PRODUCT_REASONING=
MODEL_PLANNING=
MODEL_ARCHITECTURE_REASONING=
MODEL_REPOSITORY_REASONING=
MODEL_CODE_IMPLEMENTATION=
MODEL_CODE_REVIEW=
MODEL_VERIFICATION=
MODEL_ORCHESTRATION=
# OpenAI embedding model for alias "embedding" (config/models.yaml provider: openai).
# Required for Phase 13 live semantic retrieval even when MODEL_PROVIDER=anthropic for chat.
# The OpenAI project must allow embeddings for this model (403 → live test skips with guidance).
MODEL_EMBEDDING=text-embedding-3-small
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_LIVE_TESTS=0
LLM_TEST_BUDGET_USD=5.00
RUNTIME_CHECKPOINT_SCHEMA=langgraph_runtime
GIT_PROVIDER=local
# OSS integrations stack: GIT_PROVIDER=gitea (see config/integrations/oss-dev.env)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Phase 16 integration test profile (make integrations-up)
OLYMPUS_GITEA_URL=http://127.0.0.1:3000
GITEA_API_TOKEN=
GITEA_ADMIN_USER=olympus
GITEA_ADMIN_PASSWORD=olympus-integration
OLYMPUS_MINIO_URL=http://127.0.0.1:9000
OLYMPUS_CI_RUNNER_URL=http://127.0.0.1:8090
OLYMPUS_FAULT_PROXY_URL=http://127.0.0.1:9099
OLYMPUS_WEBHOOK_SECRETS_FILE=./config/webhook_secrets.local.yaml
OTEL_EXPORTER_OTLP_ENDPOINT=
